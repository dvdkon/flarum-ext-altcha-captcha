{
    "name": "dvdkon/flarum-ext-altcha-captcha",
    "description": "Self-hosted CAPTCHA using Altcha (proof-of-work) for registration and login protection",
    "type": "flarum-extension",
    "keywords": [
        "captcha",
        "altcha",
        "proof-of-work",
        "spam",
        "registration",
        "security"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ralkage",
            "email": "me@ralkage.com",
            "homepage": "https://ralkage.com"
        },
        {
            "name": "David Koňařík",
            "email": "dvdkon@konarici.cz",
            "homepage": "https://dvdkon.ggu.cz"
        }
    ],
    "require": {
        "flarum/core": "^1.8",
        "altcha-org/altcha": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AltchaCaptcha\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Altcha CAPTCHA",
            "category": "feature",
            "icon": {
                "name": "fas fa-robot",
                "backgroundColor": "#27ae60",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
